# --- Supabase (required for Vercel production) ---
# When set, the API uses Postgres app_collections + auth tables instead of database/*.json.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional anon key (not used by the API; browser has no direct DB access)
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=transcript-files

# Comma-separated allowed browser origins for CORS (production)
# CORS_ORIGIN=https://your-app.vercel.app

# §1.1 Emails — delivery configuration
# Copy to `.env` and fill in values for the chosen provider.
# Emails are always sent to the Email Address on the relevant User record.

# Provider: postageapp | smtp | console
# If omitted: postageapp when POSTAGEAPP_API_KEY is set, else smtp when SMTP_HOST is set, else console.
EMAIL_PROVIDER=

# Shared default From identity (§1.1.2 Sender)
# Example style: Astraea <admin@stenotypisi.com>
# Prefer a registered domain belonging to the client; final address can be decided later.
EMAIL_FROM_EMAIL=admin@stenotypisi.com
EMAIL_FROM_NAME=Astraea

# Optional additional senders for different message categories.
# Keys: default | admin | scheduling | transcripts | account (or custom).
# EMAIL_SENDER_SCHEDULING_EMAIL=scheduling@stenotypisi.com
# EMAIL_SENDER_SCHEDULING_NAME=Astraea
# EMAIL_SENDER_TRANSCRIPTS_EMAIL=transcripts@stenotypisi.com
# EMAIL_SENDER_TRANSCRIPTS_NAME=Astraea
# EMAIL_SENDER_ACCOUNT_EMAIL=noreply@stenotypisi.com
# EMAIL_SENDER_ACCOUNT_NAME=Astraea
# Or JSON map:
# EMAIL_SENDERS={"scheduling":{"name":"Astraea","email":"scheduling@stenotypisi.com"},"transcripts":{"name":"Astraea","email":"transcripts@stenotypisi.com"}}

# --- Recommended: PostageApp (https://www.postageapp.com) ---
# Create a dedicated PostageApp account/project. Client covers the monthly fee.
# Configure SPF/DKIM/DMARC at the client's DNS registrar for deliverability.
POSTAGEAPP_API_KEY=
POSTAGEAPP_FROM_EMAIL=
POSTAGEAPP_FROM_NAME=Astraea
# Optional: force all messages to one inbox while testing
POSTAGEAPP_RECIPIENT_OVERRIDE=
# Optional PostageApp template slug
POSTAGEAPP_TEMPLATE=
# Optional API endpoint override
# POSTAGEAPP_API_URL=https://api.postageapp.com/v.1.0/send_message.json

# --- Alternative: application's own SMTP server ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Astraea

# Public app URL used in email action links (set to your Vercel URL in production)
APP_PUBLIC_URL=http://localhost:5173

# --- §1.1.7 Replies (Option B selected) ---
# Option B: monitored — Reply-To goes to a mailbox the client monitors
EMAIL_REPLY_MODE=monitored
EMAIL_MONITORED_REPLY_TO=support@stenotypisi.com

# Option A (alternative): unmonitored — do-not-reply notice + administrator contact
# EMAIL_REPLY_MODE=unmonitored
# EMAIL_ADMIN_CONTACT_NAME=System Administrator
# EMAIL_ADMIN_CONTACT_EMAIL=admin@stenotypisi.com
# EMAIL_ADMIN_CONTACT_TELEPHONE=
# EMAIL_UNMONITORED_REPLY_TO=noreply@stenotypisi.com
